# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# dotenv environment variable files
.env
.env.*
!.env.example

# Varlock
# Varlock recommends committing non-local .env.* files.
# Review broader existing ignore rules before opting into that convention.
!.env.schema
.env.local
.env.*.local

# Cloudflare and Wrangler local state
# No .dev.vars file may ever exist in this project. Secrets have one writer:
# Varlock reads 1Password, and varlock-wrangler deploys them. The quality
# workflow fails when a .dev.vars file exists anywhere in the workspace.
.dev.vars*
.wrangler/

# Calavera local caches. Keep .calavera/state.json and .calavera/artifacts.lock.json tracked.
.calavera/cache/
.calavera/.transactions/

# Build output of the workspace apps
apps/*/dist/

# Claude Code agent worktrees must never be committed
.claude/worktrees/

# TypeScript build info written by "tsc -b"
*.tsbuildinfo
