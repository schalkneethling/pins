{
  "name": "pins",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp -C apps/site dev",
    "build": "tsc -b && vp run --filter \"./apps/*\" build",
    "preview": "vp -C apps/site preview",
    "prepare": "vp config",
    "lint:styles": "stylelint \"**/*.{css,scss}\" --allow-empty-input",
    "lint:styles:fix": "stylelint \"**/*.{css,scss}\" --allow-empty-input --fix",
    "knip": "knip",
    "lint:html": "node scripts/lint-html.mjs \"**/*.html\"",
    "env:load": "varlock load",
    "repo:controls:check": "node scripts/repository-controls.mjs",
    "repo:controls:apply": "node scripts/repository-controls.mjs --apply",
    "quality": "vp check && vp run -r test && pnpm lint:styles && pnpm lint:html && pnpm knip && pnpm env:load"
  },
  "devDependencies": {
    "@schalkneethling/stylelint-plugin-css-property-type-validator": "0.1.0-beta.1",
    "html-validate": "^11.17.0",
    "knip": "^6.42.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "stylelint-plugin-logical-css": "^2.1.0",
    "stylelint-plugin-use-baseline": "^1.4.8",
    "typescript": "~6.0.3",
    "varlock": "^1.23.0",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  }
}
