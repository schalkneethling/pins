{
  "$schema": "https://calavera.schalkneethling.com/calavera.config.schema.json",
  "version": 1,
  "profile": "default",
  "packageManager": "pnpm",
  "integrations": [
    "editorconfig",
    "knip",
    "html-validate",
    "varlock",
    "github-repository-controls",
    "react-doctor",
    "stylelint",
    "stylelint-standard",
    "stylelint-order",
    "stylelint-baseline",
    "stylelint-logical-css",
    "css-property-type-validator"
  ],
  "scripts": {
    "lint": true,
    "lint:fix": true,
    "quality": true
  },
  "ai": [
    {
      "id": "skill-css-tokens"
    },
    {
      "id": "skill-frontend-engineering"
    },
    {
      "id": "skill-frontend-security"
    },
    {
      "id": "skill-frontend-testing"
    },
    {
      "id": "skill-more-secure-dependabot-config"
    },
    {
      "id": "agent-technical-devils-advocate",
      "target": "claude-code"
    }
  ],
  "integrationOptions": {
    "stylelint-baseline": {
      "available": "newly",
      "severity": "warning"
    },
    "github-repository-controls": {
      "repository": "schalkneethling/pins",
      "defaultBranch": "main",
      "requiredChecks": [],
      "mergeMethods": ["squash"],
      "wiki": false,
      "projects": false,
      "autoMerge": true,
      "deleteBranchOnMerge": true,
      "updateBranch": true,
      "dependabotEcosystems": ["npm", "github-actions"],
      "codeqlLanguages": ["actions", "javascript-typescript"],
      "codeqlQuerySuite": "extended",
      "releaseEnvironment": null
    }
  }
}
